ENV=local
SERVER_PORT=8089

# dev — без проверки JWT (только локально). jwt — RS256 по публичному ключу Symfony.
AUTH_MODE=dev
JWT_PUBLIC_KEY_PATH=../symfony_documents_flow/config/jwt/public.pem

CORS_ALLOWED_ORIGINS=http://localhost:3001

DB_HOST=localhost
DB_PORT=5436
DB_USER=weighing
DB_PASSWORD=weighing
DB_NAME=weighing_db
DB_MAX_CONNS=10

WEIGHING_DB_URL=postgresql://weighing:weighing@localhost:5436/weighing_db?sslmode=disable
